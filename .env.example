APP_NAME=Cinema Session Service
API_V1_PREFIX=/api/v1

MAX_PARTICIPANTS_PER_SESSION=20

# IMPORTANTE: debe ser el MISMO valor que JWT_SECRET_KEY / JWT_ALGORITHM
# configurados en Community Service, porque ese servicio es quien emite
# el token que aquí solo se valida.
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
